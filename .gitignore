# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Screenshot loop output (generated by screenshot.mjs)
/screenshots

#context files
/website-context


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# social cover source art (large binaries, local-only design inputs).
# Never read at build time: COVERS.background in src/lib/blog/taxonomy.js
# names these files, but nothing on the site consumes them. Covers are
# produced locally on request. Keep a backup copy off this machine.
/content/backgrounds/

